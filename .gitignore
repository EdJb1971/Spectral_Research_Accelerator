# Scratch Vite config for rendered inspection against a non-default backend port.
frontend/vite.inspect.config.ts

# Test scratch. Pytest's basetemp is pinned to the repo drive in pytest.ini, because the
# machine's C: drive filled and every fixture that writes a Zarr store then errored with
# `[Errno 28] No space left on device` -- 35 failures and 49 errors that looked exactly like
# code regressions and were not. Directory patterns, not file lists: earlier runs appended
# 11,490 individual temp paths here and buried the authored entries, including one that
# ignored this file itself.
.pytest-tmp/
.pytest-tmp2/
.pytest-current/
.pytest-verify/
.full-suite-tmp/
.pytest-basetemp/
_pt*.txt
data/profile_collections/e7c8acc202a81169b705dce99fd9391ca4a8c9ee3ba1f54715e3e0943e1ad773.json

# Playwright (TG17.7): scratch backend state and browser artefacts, never committed
