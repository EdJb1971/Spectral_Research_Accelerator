# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local secrets and machine-specific environment settings
.env.local

# Database
*.db

# Artifacts & caches (Phase 4A ArtifactStore, T3.5.21 Zarr cache)
artifacts/
.zarr_cache/

# Node
node_modules/
frontend/dist/

# Data (large binaries; see data/README.md)
data/*.nc
data/*.grib
data/*.grib2
data/*.zarr/
# Probe records are reproducible observations, not source; the README stays.
data/store_probes/*.json
!data/store_probes/ccdb0625e7e8fb1d.json
!data/store_probes/f9a45764fcf52c2a.json
!data/store_probes/1a28d5980c97a38e.json

# Acquired ERA5 caches and CDS shards are reproducible from the frozen request,
# and large. The immutable cross-route overlap receipt is evidence, so it stays.
data/cds_downloads/
data/era5_cache/
data/wb_cache/
data/tess_g17_raw/
data/tess_g17_periodic_raw/
data/tess_g17_records/
!data/era5_cache/
data/era5_cache/*
!data/era5_cache/*.overlap.json
!data/era5_cache/*.overlap.*.json

# The 2019 window exists to derive a criterion without tuning it to the
# window it judges. It is reproducible from the frozen request.
data/diagnostics/
*.db-shm
*.db-wal

# Isolated interpreter for the Copernicus Marine Toolbox (see requirements-ocean.txt).
.venv-copernicus/

# Scratch Vite config for rendered inspection against a non-default backend port.
frontend/vite.inspect.config.ts

# Test scratch. Pytest's basetemp is pinned to the repo drive in pytest.ini, because the
# machine's C: drive filled and every fixture that writes a Zarr store then errored with
# `[Errno 28] No space left on device` -- 35 failures and 49 errors that looked exactly like
# code regressions and were not. Directory patterns, not file lists: earlier runs appended
# 11,490 individual temp paths here and buried the authored entries, including one that
# ignored this file itself.
.pytest-tmp/
.pytest-tmp2/
.pytest-current/
.pytest-verify/
.full-suite-tmp/
.pytest-basetemp/
_pt*.txt
data/profile_collections/e7c8acc202a81169b705dce99fd9391ca4a8c9ee3ba1f54715e3e0943e1ad773.json

# Playwright (TG17.7): scratch backend state and browser artefacts, never committed
.e2e-state/
frontend/test-results/
frontend/playwright-report/

# TG17.14: the researcher-supplied order_book record. The venue's market-data terms
# restrict redistribution of raw depth, and the live-source gate binds the record by
# sha256 rather than by storing it, so the CSV is deliberately absent and its README
# carries the URL and the transformation needed to rebuild it byte-for-byte.
data/market_records/*.csv


# T4E.17: the signed external catalogue. 35.5 MB of third-party data does not belong in this
# repository -- the design says so in terms -- and it is bound by sha256 rather than stored,
# exactly as the market record and the CDS shards are. The README stays and carries the source
# URL, the digest a re-download must reproduce, and the citation the publisher requires.
data/catalogues/*.csv

# T4E.36/T4E.38/T4E.39: the joined immutable field records. The receipt JSON beside each record
# carries its content digest, the acquisition digests of every shard behind it, and the seam
# results -- that is what makes the record checkable, and it stays. The record itself is 871 MB
# of ERA5 values bound by that digest, exactly as the catalogue and the CDS shards are. The
# `data/*.zarr/` rule above matches only the top level and never reached these.
data/wrapped_records/**/*.zarr/

# Durable run state written by the runner while a measurement executes. Server-owned operational
# records rather than evidence: a clone rebuilds them by running, and committing them would put
# one machine's run identities in every other machine's tree.
data/experiment_runs/

# TG17.15: the archived lineage-bug evidence, split by what each part is. The contaminated
# partner profiles and the eight measurement artifacts that record the bug are kept, because
# they are what the readiness audit and the pool surface read. The 68 MB of raw third-party TESS
# photometry underneath them is excluded for the same reason as `data/catalogues/*.csv`.
data/superseded/g17_tess_lineage_bug/tess_g17_records/

# T4E.39: the superseded relative-humidity misrequest. Its two acquisition receipts stay, because
# what was wrongly asked for is part of the record; the NetCDF shards it downloaded are bulk data.
data/superseded/**/*.nc
